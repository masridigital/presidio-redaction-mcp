# Placeholders only. Load real values from a vault or Docker secrets.
# Never commit live tokens, HMAC keys, TLS private keys, or upstream credentials.
PRM_ENV=production
LOG_LEVEL=INFO

# Referenced by config/allowlist.yaml. Minimum 32 bytes for the HMAC key.
PRM_SECRET_AUDIT_HMAC_KEY=replace-with-vault-hmac-key-at-least-32-bytes
PRM_SECRET_GROK_BOT_TOKEN=replace-with-vault-token
PRM_SECRET_CLAUDE_LOCAL_TOKEN=replace-with-vault-token
PRM_SECRET_OPEN_WEBUI_TOKEN=replace-with-vault-token

# TLS material is mounted from Docker secrets, not written here.
# PRM_TLS_CERT_FILE=/run/secrets/tls_cert
# PRM_TLS_KEY_FILE=/run/secrets/tls_key
# PRM_PRESIDIO_CA_FILE=/run/secrets/internal_ca

# Host install only. SSH is allowed from this management/VPN subnet, not the internet.
PRM_MGMT_CIDR=10.8.0.0/24

# Verifier stays off unless config sets verifier.enabled on a deployment marked BAA (Azure).
# Do not put the Anthropic API key in this file.
# PRM_KEY_VAULT_URL=https://example.vault.azure.net
# PRM_KEY_VAULT_SECRET=anthropic-api-key
# PRM_SECRET_FILE_ANTHROPIC_API_KEY=/etc/presidio-redaction-mcp/anthropic_api_key
# VPN listener published on this address only (never 0.0.0.0).
PRM_VPN_BIND_ADDR=10.8.0.1

# Admin portal. Three HMAC keys, each at least 32 bytes, and none equal to another
# or to PRM_SECRET_AUDIT_HMAC_KEY. The process refuses the placeholder below.
# PRM_ADMIN_CLIENT_ID is the portal app registration's client id, not a secret.
# Token exchange uses a managed identity or a certificate. There is no client secret.
# PRM_ADMIN_BIND stays on localhost outside the Container Apps environment.
PRM_ADMIN_BIND=127.0.0.1
PRM_ADMIN_PORT=8080
PRM_ADMIN_CLIENT_ID=00000000-0000-4000-8000-000000000000
PRM_ADMIN_TENANT_ID=f7812296-5bce-41dc-8102-b1b270e7c4c7
PRM_ADMIN_ACRS=c1
PRM_ADMIN_ASSERTION=managed_identity
PRM_STORE_HMAC_KEY=replace-with-vault-store-hmac-key-32b
PRM_ADMIN_AUDIT_HMAC_KEY=replace-with-vault-audit-hmac-key-32b
PRM_ADMIN_SESSION_HMAC_KEY=replace-with-vault-session-hmac-key-32
# PRM_CONFIG_STORE=https://example.blob.core.windows.net/prm-config
# PRM_ADMIN_MI_CLIENT_ID=00000000-0000-4000-8000-000000000000
# PRM_ADMIN_JWKS_FILE=/run/secrets/entra_jwks.json
# PRM_ADMIN_REDIRECT_URI=https://admin.internal/auth/callback

<!--
  API Management is the OAuth front. The container re-validates the same JWT.
  Issuers are the pinned tenant v2 endpoint only. common, organizations, and
  consumers are not accepted. Named values are parameters, not secret material.
-->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="{{entra-tenant-id}}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="invalid_token">
      <client-application-ids>
        <application-id>{{claude-client-id}}</application-id>
        <application-id>{{open-webui-client-id}}</application-id>
        <application-id>{{grok-client-id}}</application-id>
      </client-application-ids>
      <audiences>
        <audience>{{entra-audience}}</audience>
      </audiences>
      <required-claims>
        <claim name="ver" match="all">
          <value>2.0</value>
        </claim>
        <claim name="roles" match="any">
          <value>Phi.Caller</value>
          <value>NonPhi.Caller</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-expiration-time="true" require-scheme="Bearer" require-signed-tokens="true">
      <openid-config url="https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>{{entra-audience}}</audience>
      </audiences>
      <issuers>
        <issuer>https://login.microsoftonline.com/{{entra-tenant-id}}/v2.0</issuer>
      </issuers>
      <required-claims>
        <claim name="roles" match="any">
          <value>Phi.Caller</value>
          <value>NonPhi.Caller</value>
        </claim>
      </required-claims>
    </validate-jwt>
    <!-- Phi.Caller is a delegated human token and must carry scp. NonPhi.Caller machine tokens have no scp. -->
    <choose>
      <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;,&quot;&quot;).AsJwt()?.Claims.GetValueOrDefault(&quot;roles&quot;, new string[]{}).Contains(&quot;Phi.Caller&quot;) == true)">
        <choose>
          <when condition="@(context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;,&quot;&quot;).AsJwt()?.Claims.GetValueOrDefault(&quot;scp&quot;, new string[]{}).Contains(&quot;access_as_user&quot;) != true)">
            <return-response>
              <set-status code="401" reason="scope_missing" />
              <set-body>{"error":"unauthorized","reason_code":"scope_missing"}</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
    <set-header name="X-MS-CLIENT-PRINCIPAL" exists-action="delete" />
    <set-header name="X-APIM-CLIENT-ID" exists-action="delete" />
    <set-header name="Cf-Access-Jwt-Assertion" exists-action="delete" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

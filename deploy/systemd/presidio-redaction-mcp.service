# Optional native process. Azure Container Apps is the primary deployment.
# The MCR analyzer image is not started. This unit starts the venv entrypoint.
[Unit]
Description=Presidio redaction MCP proxy (optional native; Azure Container Apps is primary)
After=network-online.target presidio-analyzer.service presidio-anonymizer.service
Wants=network-online.target presidio-analyzer.service presidio-anonymizer.service

[Service]
Type=simple
User=presidio-proxy
Group=presidio-proxy
WorkingDirectory=/opt/presidio-redaction-mcp
EnvironmentFile=/etc/presidio-redaction-mcp/proxy.env
LoadCredential=audit_hmac_key:/etc/presidio-redaction-mcp/secrets/audit_hmac_key
LoadCredential=grok_bot_token:/etc/presidio-redaction-mcp/secrets/grok_bot_token
LoadCredential=grok_cf_access_client_id:/etc/presidio-redaction-mcp/secrets/grok_cf_access_client_id
LoadCredential=grok_cf_access_client_secret:/etc/presidio-redaction-mcp/secrets/grok_cf_access_client_secret
LoadCredential=claude_local_token:/etc/presidio-redaction-mcp/secrets/claude_local_token
LoadCredential=open_webui_token:/etc/presidio-redaction-mcp/secrets/open_webui_token
LoadCredential=tls_cert:/etc/presidio-redaction-mcp/tls/proxy.pem
LoadCredential=tls_key:/etc/presidio-redaction-mcp/tls/proxy.key
LoadCredential=internal_ca:/etc/presidio-redaction-mcp/tls/ca.pem
ExecStart=/opt/presidio-redaction-mcp/venv/bin/presidio-redaction-mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/presidio-redaction-mcp
ReadOnlyPaths=/etc/presidio-redaction-mcp /opt/presidio-redaction-mcp

[Install]
WantedBy=multi-user.target

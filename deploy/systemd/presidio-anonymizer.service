[Unit]
Description=Optional native Presidio anonymizer (not enabled; Azure image is primary)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=presidio-anonymizer
Group=presidio-anonymizer
WorkingDirectory=/opt/presidio-anonymizer
Environment=PRESIDIO_ROLE=anonymizer
Environment=PRESIDIO_BIND=127.0.0.1
Environment=PRESIDIO_PORT=5002
Environment=PRESIDIO_CERT=/etc/presidio-redaction-mcp/tls/internal.pem
Environment=PRESIDIO_KEY=/etc/presidio-redaction-mcp/tls/internal.key
Environment=HOME=/var/lib/presidio-anonymizer
Environment=PYTHONDONTWRITEBYTECODE=1
# Primary anonymizer is the digest-pinned Container App image. This unit is not
# enabled by the installer. It starts only when the Microsoft app.py from tag
# 2.2.362 has been copied into the working directory.
ConditionPathExists=/opt/presidio-anonymizer/app.py
ExecStart=/opt/presidio-anonymizer/venv/bin/gunicorn -w 1 -b 127.0.0.1:3001 "app:create_app()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/presidio-anonymizer
ReadOnlyPaths=/etc/presidio-redaction-mcp/tls /opt/presidio-anonymizer

[Install]
WantedBy=multi-user.target

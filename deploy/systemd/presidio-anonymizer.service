[Unit]
Description=Presidio anonymizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=presidio-anonymizer
Group=presidio-anonymizer
WorkingDirectory=/opt/presidio-anonymizer
ExecStart=/opt/presidio-anonymizer/venv/bin/gunicorn -w 1 -b 127.0.0.1:3001 "app:create_app()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/presidio-anonymizer
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

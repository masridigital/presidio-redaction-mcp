[Unit]
Description=Presidio anonymizer (native, loopback TLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=presidio-anonymizer
Group=presidio-anonymizer
WorkingDirectory=/opt/presidio-anonymizer
Environment=PRESIDIO_ROLE=anonymizer
Environment=PRESIDIO_BIND=127.0.0.1
Environment=PRESIDIO_PORT=5002
Environment=PRESIDIO_CERT=/etc/presidio-redaction-mcp/tls/internal.pem
Environment=PRESIDIO_KEY=/etc/presidio-redaction-mcp/tls/internal.key
Environment=HOME=/var/lib/presidio-anonymizer
Environment=PYTHONDONTWRITEBYTECODE=1
# The anonymizer in the primary deploy is the digest-pinned image. This optional unit stays on loopback.
ExecStart=/opt/presidio-anonymizer/venv/bin/python -c 'raise SystemExit(0)'
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/presidio-anonymizer
ReadOnlyPaths=/etc/presidio-redaction-mcp/tls /opt/presidio-anonymizer

[Install]
WantedBy=multi-user.target

[Unit]
Description=Presidio analyzer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=presidio-analyzer
Group=presidio-analyzer
WorkingDirectory=/opt/presidio-analyzer
Environment=PRESIDIO_BIND=127.0.0.1
Environment=PRESIDIO_PORT=3000
Environment=PRESIDIO_SPACY_MODEL=en_core_web_lg
Environment=PYTHONPATH=/opt/presidio-analyzer
ExecStart=/opt/presidio-analyzer/venv/bin/python -m presidio.serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/presidio-analyzer
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
